pipeline {
    agent {
        label 'build-jenkins-node'
    }
    triggers {
        githubPush()
    }
    environment {
        NODE_OPTIONS = '--max_old_space_size=1024'
        DOCKER_IMAGE = 'derekpedersen/pedersen-io-spa-vue'
        K8S_NAMESPACE = 'default'
        HELM_RELEASE = 'pedersen-spa'
    }
    options {
        skipDefaultCheckout true
        timeout(time: 45, unit: 'MINUTES')
    }
    stages {
        stage('Guard: allow manual main deploys or tag-triggered deploys') {
            steps {
                script {
                    def isManual = !currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause').isEmpty()
                    def isTagBuild = env.TAG_NAME?.trim()
                    def isMainBranch = env.BRANCH_NAME == 'main'

                    if (isTagBuild) {
                        echo "Tag-triggered deploy detected for ${env.TAG_NAME}."
                        return
                    }

                    if (isManual && isMainBranch) {
                        echo 'Manual deploy from main branch allowed.'
                        return
                    }

                    error('Deploys are restricted to a manual run from main or an automatic tag-triggered build.')
                }
            }
        }

        stage('Checkout') {
            steps {
                dir('/root/workspace/pedersen.io-spa-vue') {
                    checkout scm
                }
            }
        }

        stage('Build and publish container image') {
            steps {
                script {
                    env.IMAGE_TAG = env.TAG_NAME?.trim() ?: "sha-${env.GIT_COMMIT.take(8)}"
                }

                withDockerRegistry([credentialsId: 'docker-pat', url: "https://index.docker.io/v1/"]) {
                    dir('/root/workspace/pedersen.io-spa-vue') {
                        sh './scripts/ci/publish-image.sh'
                    }
                }
            }
        }

        stage('Helm deploy') {
            steps {
                withCredentials([
                    string(credentialsId: 'digital-ocean-pat', variable: 'DIGITALOCEAN_ACCESS_TOKEN'),
                    string(credentialsId: 'digital-ocean-k8s-cluster', variable: 'DIGITALOCEAN_K8S_CLUSTER')
                ]) {
                    dir('/root/workspace/pedersen.io-spa-vue') {
                        sh './scripts/ci/helm-upgrade.sh'
                    }
                }
            }
        }
    }
}
